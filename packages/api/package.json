{
  "name": "@kisssaq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create kisssaq",
    "db:migrate:local": "wrangler d1 migrations apply kisssaq --local",
    "db:migrate:remote": "wrangler d1 migrations apply kisssaq --remote",
    "db:exec": "wrangler d1 execute kisssaq",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.11.3"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "wrangler": "^4.70.0"
  }
}
